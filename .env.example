# Gemini API credentials. Pick ONE of the two backends.

# Option 1 — Google AI Studio (simplest). Get a key at https://aistudio.google.com/.
GOOGLE_API_KEY=your-api-key-here

# Option 2 — Vertex AI (requires `gcloud auth application-default login`).
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=us-central1
